[Unit]
Description=LMS Task: lms-plugin-iptv-errors-collect
After=network-online.target

[Service]
Type=oneshot
User=apache
WorkingDirectory=/var/www/html/lmsplus/plugins/LMSIptvErrorsPlugin/bin
ExecStart=/usr/bin/php /var/www/html/lmsplus/plugins/LMSIptvErrorsPlugin/bin/lms-iptv-errors-collect.php -C /etc/lms/lms.ini --quiet
TimeoutSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallFilter=@system-service
ReadWritePaths=/var/www/html/lmsplus/plugins/LMSIptvErrorsPlugin/storage/iptv-errors
